# Environment variables for InfluxDB initial setup
# These are used by the InfluxDB container on its first run to create users, orgs, buckets, and tokens.

# Set to 'setup' to perform initial setup.
DOCKER_INFLUXDB_INIT_MODE=setup

# Username for the initial user
DOCKER_INFLUXDB_INIT_USERNAME=myuser

# Password for the initial user
DOCKER_INFLUXDB_INIT_PASSWORD=mypassword123

# Organization name for the initial organization
DOCKER_INFLUXDB_INIT_ORG=myorg

# Bucket name for the initial bucket
DOCKER_INFLUXDB_INIT_BUCKET=mybucket

# Retention period for the initial bucket (optional, 0 means infinite)
# Examples: 30d, 12w, 1y. Default is 0 (infinite).
# DOCKER_INFLUXDB_INIT_RETENTION=

# Admin token for the initial setup.
# THIS TOKEN WILL BE REQUIRED BY THE FLASK APP AND DATA PROCESSOR (as INFLUXDB_TOKEN in .env)
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=mysecretadmintoken1234567890abcdef
